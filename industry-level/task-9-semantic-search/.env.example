# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL="postgresql://shopuser:shop12345@localhost:5435/shop"
REDIS_URL="redis://localhost:6382"

# --- Embeddings ---
# transformers = local multilingual model (default, free, no API key). openai = OpenAI API. hash = offline fake for tests.
EMBEDDING_PROVIDER=transformers
# OPENAI_API_KEY=sk-...
# Embed new/changed products automatically after create/update (default true) and load the model at start-up.
# EMBEDDING_AUTO_INDEX=true
# EMBEDDING_WARMUP=true

# --- Search cache ---
# SEARCH_CACHE_TTL_SECONDS=600
# SEARCH_HOT_THRESHOLD=5
