{
  "name": "task-10-production-system",
  "version": "1.0.0",
  "description": "Production-grade e-commerce API: JWT/RBAC auth, transactional cart checkout, Redis cache, semantic search, deep health, CI/CD to Render",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "start:prod": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "bench": "tsx src/scripts/benchmark.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "seed:catalog": "tsx src/scripts/seedCatalog.ts",
    "index:products": "tsx src/scripts/indexProducts.ts",
    "bench:search": "tsx src/scripts/benchmarkSearch.ts",
    "seed:admin": "tsx src/scripts/createAdmin.ts",
    "smoke": "tsx src/scripts/smokeTest.ts",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "private": true,
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
