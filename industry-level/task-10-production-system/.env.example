# Copy this file to .env for LOCAL development. Never commit .env (it is in .gitignore).
# In the cloud these values are NOT in any file: they are environment variables on Render / secrets on GitHub.

# --- Database (PostgreSQL with pgvector) ---
DATABASE_URL="postgresql://shopuser:shop12345@127.0.0.1:5436/shop"
# Migrations need a DIRECT connection. Only needed when DATABASE_URL is a pooled URL (Neon "-pooler" host).
# DIRECT_URL="postgresql://..."
# DB_POOL_MAX=10

# --- Redis (cache, rate limiting) ---
REDIS_URL="redis://127.0.0.1:6383"

# --- Auth ---
# At least 32 random characters. REQUIRED in production (the server refuses to start without it).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="local-dev-secret-change-me-0123456789abcdef"
# JWT_EXPIRES_SECONDS=3600
# BCRYPT_ROUNDS=12
# LOGIN_RATE_LIMIT_MAX=5
# Browsers may only call the API from these origins (comma separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# First admin account, created by: npm run seed:admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-long-password

# --- Semantic search ---
# transformers = local multilingual model (needs ~1 GB RAM) | openai = OpenAI API (cloud default) | hash = offline fake for tests
EMBEDDING_PROVIDER=transformers
# OPENAI_API_KEY=sk-...
# SEARCH_CACHE_TTL_SECONDS=600
